# .env.example — every variable, token, key and secret the code reads, with DUMMY values (#272).
#
# This file is an index, not something to load: each value lives where its group says, and
# docs/code/THIRD-PARTY-ACCESS.md §8 gives each one's role, how to make it and where to keep it.
# Never put a real value here or in any committed file; .gitignore keeps every other .env* out.
#
# Where things live:
#   [wrangler var]   apps/api/wrangler.jsonc `vars`, per environment. Not secret.
#   [binding]        apps/api/wrangler.jsonc, not a variable: named here so nothing is missed.
#   [worker secret]  `wrangler secret put <NAME> --env <dev|prod>`; locally in apps/api/.dev.vars.
#   [local]          apps/api/.dev.vars (copy apps/api/.dev.vars.example) or your shell.
#   [gh secret] / [gh var]   GitHub → Settings → Environments → <dev|prod|feature> (or the repo).
#   [build var]      set when building an SPA; ends up in the public bundle, so never a secret.

# ---- API Worker: [wrangler var] -----------------------------------------------------------
ADMIN_HOST=admin.localhost
PLATFORM_HOST=platform.localhost
HOOKS_HOST=hooks.localhost
# "1" where a Hyperdrive binding exists, so a lost binding turns /health red.
HYPERDRIVE_REQUIRED=1

# ---- API Worker: [binding] (declared in wrangler.jsonc, no value to set) -----------------------
# HYPERDRIVE                  Postgres through Hyperdrive (the pooled Neon string lives in Cloudflare)
# ASSETS                      R2 bucket for uploads (dripfunnel-assets-local / -dev / prod)
# HEALTH_RATE_LIMITER         rate limit on /health
# SIGN_IN_RATE_LIMITER        rate limit on sign-in and codes
# STAFF_SESSION_RATE_LIMITER  rate limit on the staff-session routes
# CF_VERSION_METADATA         the deployed Worker version, for logs and /health

# ---- API Worker: [worker secret] ------------------------------------------------------------
# 32 random bytes in base64: `openssl rand -base64 32`. Encrypts 2-factor and merchant credentials.
CREDENTIALS_KEK=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Microsoft Entra ID app registration for staff sign-in (admin console). Absent: every staff
# sign-in is refused as provider_unconfigured.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=dummy-entra-client-secret
# DripFunnel's Stripe account (billing, Connect). Absent: billing writes answer NOT_CONNECTED and
# hooks.<host>/stripe doesn't exist. Test-mode values locally and on dev.
STRIPE_SECRET_KEY=rk_test_DUMMYrestrictedkey000000000000
STRIPE_WEBHOOK_SECRET=whsec_DUMMYsigningsecret0000000000

# ---- Local development: [local] -------------------------------------------------------------
# Local Postgres only (AGENTS.md rule 3); 5434 if another Postgres holds 5432 (api/README §7).
# The scripts (migrate, seed, session) and the integration tests read DATABASE_URL;
# `wrangler dev --env local` reads the Hyperdrive one.
DATABASE_URL=postgres://dripfunnel_dev:dripfunnel_dev@localhost:5432/dripfunnel
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://dripfunnel_dev:dripfunnel_dev@localhost:5432/dripfunnel
# Your own fine-grained GitHub token for Claude Code's GitHub MCP server (.mcp.json). Personal.
GITHUB_PAT=github_pat_DUMMY000000000000000000000000000000

# ---- Migrations and tests against a remote database: [gh var] / [local] ------------------------
# Hostnames, not secrets. The migration runner refuses any remote host but ALLOWED_MIGRATION_HOST.
# ALLOWED_TEST_HOST is a [gh var] only: the gates step passes it to the runner as
# ALLOWED_MIGRATION_HOST, pinning TEST_DATABASE_URL's host.
ALLOWED_MIGRATION_HOST=ep-example-000000.eu-central-1.aws.neon.tech
ALLOWED_TEST_HOST=ep-example-test-000000.eu-central-1.aws.neon.tech
# "1" together with CI=true lets migrations reach the allowed remote host. CI sets both itself.
ALLOW_REMOTE_MIGRATIONS=0
CI=false

# ---- CI: [gh secret] ------------------------------------------------------------------------
# One per GitHub environment (dev, prod, feature), each scoped to its own Cloudflare account.
CLOUDFLARE_API_TOKEN=dummy-cloudflare-api-token
# Neon connection strings for the deploy migrations and the CI gates.
DEV_DATABASE_URL=postgres://migrator:dummy@ep-example-000000.eu-central-1.aws.neon.tech/dripfunnel?sslmode=require
PROD_DATABASE_URL=postgres://migrator:dummy@ep-example-prod-000000.eu-central-1.aws.neon.tech/dripfunnel?sslmode=require
TEST_DATABASE_URL=postgres://tester:dummy@ep-example-test-000000.eu-central-1.aws.neon.tech/dripfunnel?sslmode=require
# Neon API key scoped to the dev project: creates and deletes feature-environment branches.
NEON_API_KEY=napi_DUMMY0000000000000000000000000000
# Claude Code's review on every pull request (`claude setup-token`). Personal, expires.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-DUMMY0000000000000000
# GITHUB_TOKEN is GitHub's own, per run: never set it.

# ---- CI: [gh var] ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
NEON_PROJECT_ID=example-project-000000
# Feature environments (dev Cloudflare account): the dripfunnel.ai zone and its id.
FEATURE_DOMAIN=dripfunnel.ai
FEATURE_ZONE_ID=00000000000000000000000000000000
# Set by the feature-env workflow for its own steps, from the Neon branch it creates.
FEATURE_DATABASE_URL=postgres://app:dummy@ep-example-feature-000000.eu-central-1.aws.neon.tech/dripfunnel?sslmode=require

# ---- SPAs: [build var] (public; never a secret) ----------------------------------------------
# "1" builds the ?state= harness into a console (feature and dev builds only, never production).
VITE_STATE_HARNESS=
# Where the portals' staff-session links lead when not under `vite dev` (https only).
VITE_ADMIN_URL=https://admin.dripfunnel.com

# ---- Planned: NOT READ YET -----------------------------------------------------------------
