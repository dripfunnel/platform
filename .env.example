# [worker secret] AI (§2.6)
# ANTHROPIC_API_KEY=sk-ant-api03-DUMMY0000000000000000
# AI_GATEWAY_TOKEN=dummy-ai-gateway-token
# [worker secret] Google sign-in on the portal (§2.9)
# GOOGLE_CLIENT_ID=000000000000-dummy.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-DUMMY0000000000
# [worker secret] / [build var] Turnstile bot check (§2.1, proposed)
# TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000
# VITE_TURNSTILE_SITE_KEY=0x00000000000000000000
# [worker secret] Courier aggregator for US carriers (§3.2)
# SHIPPING_AGGREGATOR_API_KEY=dummy-easypost-or-shippo-key
# [worker secret] Keys the platform generates itself (§5)
# HANDOFF_SIGNING_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
