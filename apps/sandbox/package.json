{
  "name": "@dripfunnel/sandbox",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "start:local": "env -i PATH=\"$PATH\" PORT=8790 SANDBOX_SLOTS=50 SANDBOX_WORK=\"${TMPDIR:-/tmp}/dripfunnel-sandbox\" tsx src/main.ts"
  },
  "dependencies": {
    "@dripfunnel/storefront-core": "workspace:*",
    "@stripe/stripe-js": "^10.0.0",
    "@types/react": "^19.3.0",
    "axe-core": "~4.13.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "motion": "^14.1.0",
    "playwright-core": "~1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  }
}
