# apps/api — every value the API Worker, its scripts and its tests read (#272). DUMMY values only.
#
# Local: copy to apps/api/.env.local (gitignored) and fill in. `pnpm dev`, the scripts (migrate,
# seed, session, schema) and both test suites load .env.local themselves; nothing to export.
# dev, prod and feature: set on that Worker, never in a file —
#   Cloudflare dashboard › Workers & Pages › <worker> › Settings › Variables and Secrets
#   (dripfunnel-api-dev, dripfunnel-api; feature Workers get theirs from the feature-env
#   workflow). wrangler.jsonc holds bindings only and keeps these on deploy (keep_vars).
# Roles, how to make each value and least scope: docs/code/THIRD-PARTY-ACCESS.md §8.

# ---- Worker: plain variables (Type: Text) ---------------------------------------------------
# Which hostname is which API. dev: dev-admin.dripfunnel.ai …; prod: admin.dripfunnel.com …
ADMIN_HOST=admin.localhost
EDGE_ZONE=dripfunnel.ai
PLATFORM_HOST=platform.localhost
HOOKS_HOST=hooks.localhost
# "1" where the Worker has a Hyperdrive binding, so losing it turns /health red.
HYPERDRIVE_REQUIRED=1

# ---- Worker: secrets (Type: Secret) ---------------------------------------------------------
# 32 random bytes in base64, one per environment: `openssl rand -base64 32`.
CREDENTIALS_KEK=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Staff sign-in (Microsoft Entra ID). Optional locally: without them staff sign-in is refused.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=dummy-entra-client-secret
# DripFunnel's Stripe account, test mode outside prod. Optional locally: without them billing
# answers NOT_CONNECTED and the Stripe hook doesn't exist.
STRIPE_SECRET_KEY=rk_test_DUMMYrestrictedkey000000000000
STRIPE_WEBHOOK_SECRET=whsec_DUMMYsigningsecret0000000000
# Card checkout on merchants' connected accounts (#309), commented out until you have test-mode values: the publishable key in
# STRIPE_SECRET_KEY's mode, and the Connect app's id (docs/setup/local.md §8).
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_CONNECT_CLIENT_ID=ca_...
# Amazon SES (#274), commented out until you have an account's values. These four and EMAIL_SUPPRESSION_KEY, or none:
# without them email waits in the outbox (or, locally, goes to the stand-in, EMAIL_LOCAL below). The sender domain is
# verified in that SES account; DripFunnel sends from no-reply@<it>, partners' merchants' email from
# no-reply@<partner label>.<it>. In the SES sandbox, recipients must be verified addresses too.
# SES_REGION=eu-west-1
# SES_ACCESS_KEY_ID=AKIADUMMY0000000000
# SES_SECRET_ACCESS_KEY=dummy-ses-secret-access-key
# SES_SENDER_DOMAIN=dummy-sender.example.com
# Keys the suppression list's address hashes, so the table can't confirm a guessed address.
# 32 random bytes in base64, one per environment: `openssl rand -base64 32`. Needed with the four above, or EMAIL_LOCAL.
EMAIL_SUPPRESSION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# The SNS topic SES sends bounces and complaints to, subscribed to https://<HOOKS_HOST>/ses. Optional
# locally: SNS can't reach your machine.
SES_EVENTS_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:dummy-ses-events
# DripFunnel's Shopify app for Connect Shopify (CATALOG K7): its client id and secret, commented out until you
# have an app's values. SHOPIFY_LOCAL=1 (local only, and it wins over the two) answers with an empty shop instead.
# SHOPIFY_CLIENT_ID=00000000000000000000000000000000
# SHOPIFY_CLIENT_SECRET=dummy-shopify-secret
SHOPIFY_LOCAL=1
# Local stand-ins for the last step of email, SMS, couriers and DNS (docs/setup/local.md §6.1). The outbox, templates and domain
# checks run as on dev; emails and texts print in the `pnpm dev` terminal and in apps/api/.local-mail/, couriers quote a
# fixed tariff, and a partner's *.localhost addresses verify. Local only: the Worker refuses to start with them on any other host.
# Asked for, a stand-in wins over the provider's values, as SHOPIFY_LOCAL does: to send through SES, remove EMAIL_LOCAL.
EMAIL_LOCAL=1
SMS_LOCAL=1
DNS_LOCAL=1
COURIERS_LOCAL=1
# 1 (or unset) checks email and text codes; 0 accepts any code (dev uses it).
CODE_CHECK=1

# ---- Local only --------------------------------------------------------------------------------
# Optional: `pnpm --filter ./apps/api seed` gives every seeded merchant, supplier and partner user this password
# (at least 10 characters). Without it they sign in after Forgot password. Read by the seed only.
# SEED_PASSWORD=
# Your local Postgres 18 (AGENTS.md rule 3: never a remote database). 5434 if another Postgres
# holds 5432 (docs/api/README.md §7). The scripts and tests read DATABASE_URL; `wrangler dev`
# reads the Hyperdrive one, which needs a password in the URL even if Postgres ignores it.
DATABASE_URL=postgres://dripfunnel_dev:dripfunnel_dev@localhost:5432/dripfunnel
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://dripfunnel_dev:dripfunnel_dev@localhost:5432/dripfunnel

# Cloudflare for SaaS custom hostnames (docs/code/THIRD-PARTY-ACCESS.md §2.1, SAAS.md §8).
CF_CUSTOM_HOSTNAMES_TOKEN=
CF_SAAS_ZONE_ID=

# Storefront hosting (#287), commented out until you have values: the R2 storefront upload credential
# (Object Read & Write on the storefront buckets only), the cache purge token, the preview link key and
# the provisioning GitHub App (no webhook).
# R2_STOREFRONT_ACCOUNT_ID=00000000000000000000000000000000
# R2_STOREFRONT_ACCESS_KEY_ID=dummy-r2-storefront-access-key-id
# R2_STOREFRONT_SECRET_ACCESS_KEY=dummy-r2-storefront-secret-access-key
# CF_CACHE_PURGE_TOKEN=dummy-cache-purge-token
# The preview domain: preview.localhost locally, the dev domain on dev (PREVIEW.md §9).
# PREVIEW_DOMAIN=preview.localhost
# One per environment, never a shared value: `openssl rand -base64 32`.
# PREVIEW_LINK_KEY=
# GITHUB_APP_ID=000000
# GITHUB_APP_INSTALLATION_ID=00000000
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nDUMMY\n-----END RSA PRIVATE KEY-----"

# ---- Not here ----------------------------------------------------------------------------------
# Bindings (HYPERDRIVE, ASSETS, the three rate limiters, CF_VERSION_METADATA) are wrangler.jsonc.
# CI-only values live in GitHub environments, because they act before or around the Worker:
#   CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, DEV_/PROD_/TEST_DATABASE_URL, ALLOWED_*_HOST,
#   NEON_API_KEY, NEON_PROJECT_ID, FEATURE_DOMAIN, FEATURE_ZONE_ID, CLAUDE_CODE_OAUTH_TOKEN.
#   The migrate script reads ALLOW_REMOTE_MIGRATIONS and ALLOWED_MIGRATION_HOST only in CI.
# Each partner's own AI, courier, SMS/WhatsApp, Google and support-chat credentials live in the
# database, set in the partner console (#275); merchants' credentials likewise.
