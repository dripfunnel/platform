{
  "name": "@dripfunnel/api",
  "private": true,
  "type": "module",
  "imports": {
    "#core/*": "./src/core/*.ts",
    "#db/*": "./src/db/*.ts",
    "#auth/*": "./src/auth/*.ts",
    "#engine/*": "./src/engine/*.ts",
    "#integrations/*": "./src/integrations/*.ts",
    "#saas/*": "./src/saas/*.ts",
    "#apis/*": "./src/apis/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#jobs/*": "./src/jobs/*.ts"
  },
  "scripts": {
    "dev": "pnpm check:local && wrangler dev --env local",
    "check:local": "tsx --env-file-if-exists=.env.local scripts/local/main.ts",
    "setup:local": "tsx --env-file-if-exists=.env.local scripts/local/main.ts --setup && pnpm migrate && pnpm seed",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "schema": "tsx --env-file-if-exists=.env.local scripts/print-schema.ts",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate/main.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed/main.ts",
    "dev-env:attach": "tsx --env-file-if-exists=.env.local scripts/dev-env/main.ts",
    "session": "tsx --env-file-if-exists=.env.local scripts/session/main.ts"
  },
  "dependencies": {
    "@pothos/core": "^4.15.1",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.24.1",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "wrangler": "^4.141.0"
  }
}
