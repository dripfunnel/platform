# Copy to .dev.vars: what `wrangler dev --env local`, the scripts and the integration tests read.
# Every variable the code reads, and where each lives elsewhere, is the root .env.example and
# docs/code/THIRD-PARTY-ACCESS.md §8. Dummy values only; local Postgres only (AGENTS.md rule 3).
# If another Postgres already holds 5432, run the 18 instance on another port
# (docs/api/README.md §7 suggests 5434) and change both URLs below to match.
DATABASE_URL="postgres://dripfunnel_dev:dripfunnel_dev@localhost:5432/dripfunnel"
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgres://dripfunnel_dev:dripfunnel_dev@localhost:5432/dripfunnel"

# The credential key-encryption key (THIRD-PARTY-ACCESS.md §5), 32 bytes in base64. Any value works
# locally; make one with: openssl rand -base64 32
CREDENTIALS_KEK="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# Optional locally. Without them staff sign-in is refused as provider_unconfigured and billing
# answers NOT_CONNECTED. Use a test Entra registration and Stripe test-mode keys, never live ones.
# ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"
# ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# ENTRA_CLIENT_SECRET="dummy-entra-client-secret"
# STRIPE_SECRET_KEY="rk_test_DUMMYrestrictedkey000000000000"
# STRIPE_WEBHOOK_SECRET="whsec_DUMMYsigningsecret0000000000"
