{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dripfunnel-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Values live on each Worker (dashboard › Settings › Variables and Secrets) and locally in
  // apps/api/.env.local, never here (#272): this file holds bindings only, and a deploy keeps
  // the dashboard's values instead of deleting them. The Worker refuses to start without them.
  "keep_vars": true,
  "ratelimits": [
    { "name": "HEALTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "SIGN_IN_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "STAFF_SESSION_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "SHOP_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 600, "period": 60 } },
    { "name": "CART_RATE_LIMITER", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
    { "name": "OFFER_CODE_RATE_LIMITER", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_RATE_LIMITER", "namespace_id": "1030", "simple": { "limit": 1200, "period": 60 } }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "images": { "binding": "IMAGES" },
  // The outbox sweep (api/README.md §5, jobs/queues/outbox-relay.ts). Inherited by every env.
  "triggers": { "crons": ["* * * * *"] },
  // No top-level `hyperdrive` binding yet: production has no Hyperdrive resource
  // provisioned (`wrangler hyperdrive create`, then add `{ "binding": "HYPERDRIVE", "id": "<resource-id>" }`
  // here). Until then, `wrangler deploy` ships without HYPERDRIVE; /health reports
  // `{ ok: true, db: "unconfigured" }` (200), not a failure, so no monitor alarms (§7).
  "env": {
    // `wrangler dev --env local` only: no Hyperdrive resource is provisioned yet
    // (`wrangler hyperdrive create`), so this placeholder id stays out of the config
    // `wrangler deploy` (production) reads. Local dev uses `localConnectionString`
    // (CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in apps/api/.env.local).
    "local": {
      "ratelimits": [
        { "name": "HEALTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "SIGN_IN_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
        { "name": "STAFF_SESSION_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
        { "name": "SHOP_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 600, "period": 60 } },
        { "name": "CART_RATE_LIMITER", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
        { "name": "OFFER_CODE_RATE_LIMITER", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } },
        { "name": "API_RATE_LIMITER", "namespace_id": "1030", "simple": { "limit": 1200, "period": 60 } }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "images": { "binding": "IMAGES" },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "local-placeholder" }],
      // Wrangler's local R2. dev has its own bucket and binding; prod gains one once its bucket exists
      // (THIRD-PARTY-ACCESS.md §2.1): a binding to a missing bucket fails the deploy.
      "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "dripfunnel-assets-local" }],
      "queues": {
        "producers": [{ "binding": "OUTBOX_WAKE", "queue": "dripfunnel-outbox-wake-local" }],
        "consumers": [{ "queue": "dripfunnel-outbox-wake-local", "max_batch_size": 100, "max_batch_timeout": 1 }]
      }
    },
    // `wrangler deploy --env dev`, from .github/workflows/dev.yml, on every push to `dev`
    // (ARCHITECTURE.md §6). Same dev Cloudflare account as feature environments (selected
    // via the job's CLOUDFLARE_ACCOUNT_ID, not this file). The ratelimit namespace id below
    // is a placeholder until that account's config exists.
    "dev": {
      "name": "dripfunnel-api-dev",
      "routes": [
        { "pattern": "dev-admin.dripfunnel.ai/api/*", "zone_name": "dripfunnel.ai" },
        { "pattern": "dev-platform.dripfunnel.ai/api/*", "zone_name": "dripfunnel.ai" },
        { "pattern": "dev-store.dripfunnel.ai/api/*", "zone_name": "dripfunnel.ai" },
        { "pattern": "dev-hooks.dripfunnel.ai", "custom_domain": true }
      ],
      "ratelimits": [
        { "name": "HEALTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "SIGN_IN_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
        { "name": "STAFF_SESSION_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
        { "name": "SHOP_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 600, "period": 60 } },
        { "name": "CART_RATE_LIMITER", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
        { "name": "OFFER_CODE_RATE_LIMITER", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } },
        { "name": "API_RATE_LIMITER", "namespace_id": "1030", "simple": { "limit": 1200, "period": 60 } }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "images": { "binding": "IMAGES" },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "14585374cf2244d19e79f102dad95205" }],
      "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "dripfunnel-assets-dev" }],
      // Prod gains its queue once it exists (docs/setup/prod.md): a binding to a missing queue fails the deploy.
      "queues": {
        "producers": [{ "binding": "OUTBOX_WAKE", "queue": "dripfunnel-outbox-wake-dev" }],
        "consumers": [{ "queue": "dripfunnel-outbox-wake-dev", "max_batch_size": 100, "max_batch_timeout": 1 }]
      }
    },
    // `wrangler deploy --env prod`, uploaded by .github/workflows/prod.yml on every push to
    // `main` and promoted to 100% by .github/workflows/promote.yml (§6). Same values as the
    // top-level config (kept as the implicit default for now); explicit so the workflows can
    // name the env instead of relying on that default.
    // No `hyperdrive` binding yet: see the top-level comment above. When #51 adds it, set
    // HYPERDRIVE_REQUIRED=1 on the Worker too, so a lost binding turns /health red (#30).
    "prod": {
      "name": "dripfunnel-api",
      "ratelimits": [
        { "name": "HEALTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "SIGN_IN_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
        { "name": "STAFF_SESSION_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
        { "name": "SHOP_RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 600, "period": 60 } },
        { "name": "CART_RATE_LIMITER", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
        { "name": "OFFER_CODE_RATE_LIMITER", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } },
        { "name": "API_RATE_LIMITER", "namespace_id": "1030", "simple": { "limit": 1200, "period": 60 } }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "images": { "binding": "IMAGES" }
    }
  }
}
