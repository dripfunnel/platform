{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dripfunnel-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ADMIN_HOST": "admin.dripfunnel.com",
    "PLATFORM_HOST": "platform.dripfunnel.com",
    "HOOKS_HOST": "hooks.dripfunnel.com"
  },
  "ratelimits": [
    { "name": "HEALTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "SIGN_IN_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // No top-level `hyperdrive`: a bare `wrangler deploy` ships without HYPERDRIVE, and /health
  // reports `{ ok: true, db: "unconfigured" }` (200) rather than alarming (§7).
  "env": {
    // `wrangler dev --env local` only; placeholder id, real connection via
    // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (not committed).
    "local": {
      "vars": {
        "ADMIN_HOST": "admin.localhost",
        "PLATFORM_HOST": "platform.localhost",
        "HOOKS_HOST": "hooks.localhost"
      },
      "ratelimits": [
        { "name": "HEALTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "SIGN_IN_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "local-placeholder" }]
    },
    // `wrangler deploy --env dev` from .github/workflows/dev.yml on push to `dev` (§6).
    "dev": {
      "name": "dripfunnel-api-dev",
      "vars": {
        "ADMIN_HOST": "dev-admin.dripfunnel.com",
        "PLATFORM_HOST": "dev-platform.dripfunnel.com",
        "HOOKS_HOST": "dev-hooks.dripfunnel.com"
      },
      "ratelimits": [
        { "name": "HEALTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "SIGN_IN_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "14585374cf2244d19e79f102dad95205" }]
    },
    // `wrangler deploy --env prod` from .github/workflows/prod.yml on push to `main` (§6).
    "prod": {
      "name": "dripfunnel-api",
      "vars": {
        "ADMIN_HOST": "admin.dripfunnel.com",
        "PLATFORM_HOST": "platform.dripfunnel.com",
        "HOOKS_HOST": "hooks.dripfunnel.com"
      },
      "ratelimits": [
         { "name": "HEALTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
        { "name": "SIGN_IN_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "3f5dde455e2a43e1b61f0aa1c08460a4" }]
       

    }
  }
}
