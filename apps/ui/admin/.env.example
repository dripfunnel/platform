# apps/ui/admin — the build flags this console reads (#272). DUMMY values only.
# Local: copy to apps/ui/admin/.env.local (gitignored); Vite loads it. Under `vite dev` nothing is
# needed. These are build-time and public: they end up in the bundle, so never a secret. The API
# values this console relies on live on the API Worker (apps/api/.env.example).

# "1" builds the ?state= harness in (feature and dev builds only, never production).
VITE_STATE_HARNESS=
