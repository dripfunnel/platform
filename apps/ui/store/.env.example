# apps/ui/store — the build flags this console reads (#272). DUMMY values only.
# Local: copy to apps/ui/store/.env.local (gitignored); Vite loads it. Under `vite dev` nothing is
# needed. These are build-time and public: they end up in the bundle, so never a secret. The API
# values this console relies on live on the API Worker (apps/api/.env.example).

# "1" builds the ?state= harness in (feature and dev builds only, never production).
VITE_STATE_HARNESS=
# Where staff-session links lead outside `vite dev` (https only). Default: production.
VITE_ADMIN_URL=https://admin.dripfunnel.com
