# Copy to .env.local (gitignored). Only PARTNER_KEY goes there: it picks partners/<PARTNER_KEY>.env.
PARTNER_KEY=dev

# The variables a partners/<partner>.env file must hold, with dummy values (CONFIGURATION.md §2).
# Copy this block to partners/<partner>.env for a new partner. Public values only, never a secret.
# PARTNER_KEY=northstar
# PARTNER_DOMAIN=store.northstar.com
# APP_NAME=Northstar Shops
# IOS_BUNDLE_ID=com.northstar.shops
# ANDROID_PACKAGE=com.northstar.shops
# APP_SCHEME=northstarshops
# ICON_IMAGE=partners/northstar/icon.png
# ANDROID_ICON_FOREGROUND=partners/northstar/icon-foreground.png
# ANDROID_ICON_BACKGROUND="#0A2A4A"
# SPLASH_IMAGE=partners/northstar/splash.png
# SPLASH_BACKGROUND="#FDFAF7"
# UPDATES_CHANNEL=northstar
