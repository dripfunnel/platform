# Copy to .env.local (gitignored). Only STORE_KEY goes there: it picks stores/<STORE_KEY>.env.
STORE_KEY=dev

# The variables a stores/<store>.env file must hold, with dummy values (docs/mobile-app/README.md §3).
# Copy this block to stores/<store>.env for a new store. Public values only, never a secret.
# STORE_KEY=acme
# STORE_HOST=acme.my-store.one
# APP_NAME="Acme Delivery"
# IOS_BUNDLE_ID=com.acme.delivery
# ANDROID_PACKAGE=com.acme.delivery
# APP_SCHEME=acmedelivery
# ICON_IMAGE=stores/acme/icon.png
# ANDROID_ICON_FOREGROUND=stores/acme/icon-foreground.png
# ANDROID_ICON_BACKGROUND="#0A2A4A"
# SPLASH_IMAGE=stores/acme/splash.png
# SPLASH_BACKGROUND="#FDFAF7"
# UPDATES_CHANNEL=acme
# Optional, for push: the store's EAS project id and its Firebase file for Android (both public).
# EAS_PROJECT_ID=0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d
# GOOGLE_SERVICES_FILE=stores/acme/google-services.json
