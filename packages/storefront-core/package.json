{
  "name": "@dripfunnel/storefront-core",
  "version": "0.0.0",
  "description": "The locked commerce core every DripFunnel storefront runs on.",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/dripfunnel/platform.git", "directory": "packages/storefront-core" },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "files": ["dist", "presets"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./guard": { "types": "./dist/guard/index.d.ts", "default": "./dist/guard/index.js" },
    "./testing": { "types": "./dist/testing/index.d.ts", "default": "./dist/testing/index.js" },
    "./tsconfig": "./presets/tsconfig.json",
    "./eslint": "./presets/eslint.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
