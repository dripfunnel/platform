{
  "name": "platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter='./apps/**'",
    "dev:all": "turbo run dev",
    "dev:https": "sh scripts/local/dev-https.sh",
    "setup:local": "pnpm install && pnpm --filter ./apps/api setup:local",
    "dev:api": "turbo run dev --filter=@dripfunnel/api",
    "dev:store": "turbo run dev --filter=@dripfunnel/store",
    "dev:platform": "turbo run dev --filter=@dripfunnel/platform",
    "dev:admin": "turbo run dev --filter=@dripfunnel/admin",
    "dev:storefront": "turbo run dev --filter=@dripfunnel/storefront-template",
    "dev:storefront-core": "turbo run dev --filter=@dripfunnel/storefront-core",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "changeset": "changeset",
    "git-hooks": "sh scripts/git/install-hooks.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "turbo": "^2.11.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
