{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dripfunnel-store-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  // Its own request lines only, which leave out preview tokens and studio sessions (LOGGING §9); no automatic invocation logs.
  "observability": { "enabled": false },
  "logpush": false,
  "env": {
    // `wrangler dev --env local` (docs/setup/local.md §6.3): preview and shop hosts, behind Caddy, on the API Worker's local bucket.
    "local": {
      "vars": { "OWN_ZONE": "dripfunnel.ai", "PAGES_HOST": "localhost", "PREVIEW_DOMAIN": "preview.localhost" },
      "services": [
        { "binding": "API", "service": "dripfunnel-api-local", "entrypoint": "PortalProxy" },
        { "binding": "EDGE", "service": "dripfunnel-api-local", "entrypoint": "StorefrontEdge" }
      ],
      "r2_buckets": [{ "binding": "SITES", "bucket_name": "storefront-sites-local" }]
    },
    // Partner portal hosts arrive here through Cloudflare for SaaS (SAAS.md §8); `*/*` catches
    // them, and the Worker passes every host of our own zone straight through.
    "dev": {
      "name": "dripfunnel-store-proxy-dev",
      "vars": { "OWN_ZONE": "dripfunnel.ai", "PAGES_HOST": "dripfunnel-store-dev.pages.dev", "PREVIEW_DOMAIN": "preview.actuateminds.com" },
      // The API serves a partner's own host only on this entrypoint (SAAS.md §8, #426); EDGE is the storefront and preview edge.
      "services": [
        { "binding": "API", "service": "dripfunnel-api-dev", "entrypoint": "PortalProxy" },
        { "binding": "EDGE", "service": "dripfunnel-api-dev", "entrypoint": "StorefrontEdge" }
      ],
      "r2_buckets": [{ "binding": "SITES", "bucket_name": "storefront-sites-dev" }],
      // The secret PREVIEW_SESSION_KEY is set by hand (docs/setup/dev.md §2.8 item 8); a binding to a missing zone fails the deploy.
      "routes": [
        { "pattern": "*/*", "zone_name": "dripfunnel.ai" },
        { "pattern": "*.preview.actuateminds.com/*", "zone_name": "actuateminds.com" }
      ]
    }
  }
}
